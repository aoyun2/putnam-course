% V3 letterpress rag-paper ink scaled proportionally to current \pgflinewidth (100% opaque, zero blur).
\pgfdeclaredecoration{ink v3}{step}{%
 \state{step}[width=0.90pt]{%
  \pgfscope
   \pgfsetarrowsstart{}\pgfsetarrowsend{}\pgfsetroundcap
   \pgf@xa=\pgfdecoratedcompleteddistance\edef\ink@d{\strip@pt\pgf@xa}%
   \pgf@xb=\pgflinewidth\edef\ink@base{\strip@pt\pgf@xb}%
   \pgfmathparse{\ink@base*(1.03+0.09*sin(mod(\ink@d,10)*36)+0.04*cos(mod(\ink@d,4.5)*80)+0.05*(rnd-0.5))}%
   \let\ink@w\pgfmathresult
   \pgfsetlinewidth{\ink@w pt}%
   \pgfpathmoveto{\pgfpointorigin}%
   \pgfpathlineto{\pgfpoint{0.98pt}{0pt}}%
   \pgfusepath{stroke}%
   \pgfmathparse{rnd}%
   \ifdim\pgfmathresult pt<0.74pt
    \pgfmathparse{rnd<0.5?-1:1}\let\ink@s\pgfmathresult
    \pgfmathparse{\ink@s*(0.5*\ink@w-0.02*\ink@base+0.04*\ink@base*rnd)}\let\ink@yy\pgfmathresult
    \pgfmathparse{0.90*rnd}\let\ink@xx\pgfmathresult
    \pgfmathparse{\ink@xx+0.01}\let\ink@xxe\pgfmathresult
    \pgfmathparse{\ink@base*(0.30+0.20*rnd)}\let\ink@bw\pgfmathresult
    \pgfsetlinewidth{\ink@bw pt}%
    \pgfpathmoveto{\pgfpoint{\ink@xx pt}{\ink@yy pt}}%
    \pgfpathlineto{\pgfpoint{\ink@xxe pt}{\ink@yy pt}}%
    \pgfusepath{stroke}%
   \fi
   \pgfmathparse{rnd}%
   \ifdim\pgfmathresult pt<0.32pt
    \pgfmathparse{rnd<0.5?-1:1}\let\ink@sB\pgfmathresult
    \pgfmathparse{\ink@sB*(0.5*\ink@w+0.03*\ink@base)}\let\ink@yyB\pgfmathresult
    \pgfmathparse{0.90*rnd}\let\ink@xxB\pgfmathresult
    \pgfmathparse{\ink@base*(0.14+0.06*rnd)}\let\ink@rB\pgfmathresult
    \pgfsetfillcolor{white}%
    \pgfpathcircle{\pgfpoint{\ink@xxB pt}{\ink@yyB pt}}{\ink@rB pt}%
    \pgfusepath{fill}%
   \fi
  \endpgfscope
 }%
 \state{final}{}%
}

% True circular guide dots with subtle natural weight variation; inherits stroke color cleanly.
\pgfdeclaredecoration{ink guide dots}{step}{%
 \state{step}[width=2.7pt]{%
  \pgfscope
   \pgfsetarrowsstart{}\pgfsetarrowsend{}\pgfsetroundcap
   \pgfmathparse{0.70+0.07*rnd}\let\ink@gw\pgfmathresult
   \pgfmathparse{0.03*(rnd-0.5)}\let\ink@gdy\pgfmathresult
   \pgfsetlinewidth{\ink@gw pt}%
   \pgfpathmoveto{\pgfpoint{0pt}{\ink@gdy pt}}%
   \pgfpathlineto{\pgfpoint{0.01pt}{\ink@gdy pt}}%
   \pgfusepath{stroke}%
  \endpgfscope
 }%
 \state{final}{}%
}

% True round solid and hollow plot markers with microscopic rag-paper rim beads.
\pgfdeclareplotmark{inkdot}{%
 \pgfscope
  \pgfpathcircle{\pgfpointorigin}{\pgfplotmarksize}%
  \@tempcnta=0
  \loop
   \pgfmathparse{360*rnd}\let\ink@a\pgfmathresult
   \pgfmathparse{\pgfplotmarksize*0.97}\let\ink@rr\pgfmathresult
   \pgfpathcircle{\pgfpointpolar{\ink@a}{\ink@rr pt}}{0.09pt}%
   \advance\@tempcnta by 1
  \ifnum\@tempcnta<5\repeat
  \pgfusepath{fill}%
 \endpgfscope
}

\pgfdeclareplotmark{inkring}{%
 \pgfscope
  \pgfpathcircle{\pgfpointorigin}{\pgfplotmarksize}%
  \pgfusepath{fill,stroke}%
  \pgfsetroundcap\pgfsetlinewidth{0.15pt}%
  \@tempcnta=0
  \loop
   \pgfmathparse{360*rnd}\let\ink@a\pgfmathresult
   \pgfmathparse{\pgfplotmarksize+0.25pt}\let\ink@rr\pgfmathresult
   \pgfmathparse{\ink@rr*cos(\ink@a)}\let\ink@bx\pgfmathresult
   \pgfmathparse{\ink@bx+0.01}\let\ink@bxe\pgfmathresult
   \pgfmathparse{\ink@rr*sin(\ink@a)}\let\ink@by\pgfmathresult
   \pgfpathmoveto{\pgfpoint{\ink@bx pt}{\ink@by pt}}%
   \pgfpathlineto{\pgfpoint{\ink@bxe pt}{\ink@by pt}}%
   \pgfusepath{stroke}%
   \advance\@tempcnta by 1
  \ifnum\@tempcnta<3\repeat
 \endpgfscope
}

\tikzset{
 ink line/.style={line width=.46pt,line cap=round,line join=round},
 ink arrow/.style={ink line,-{Stealth[length=4.6pt,width=2.0pt,inset=1.2pt]}},
 ink guide/.style={decorate,decoration={ink guide dots}},
 ink guide arrow/.style={line width=.72pt,line cap=round,dash pattern=on 0.05pt off 2.7pt,-{Stealth[length=4.6pt,width=2.0pt,inset=1.2pt]}},
 ink dotted/.style={line width=1.35pt,line cap=round,dash pattern=on 0.05pt off 2.8pt},
 ink grain/.style={preaction={fill=#1,fill opacity=.05},pattern=inkgrain,pattern color=#1},
 ink grain/.default=inkblue,
 ink v3 stroke/.style={ink line,postaction={decorate,decoration={ink v3}}},
 ink plot/.style={ink v3 stroke}
}
% Deterministic seed per stroke; arrows/axes stay crisp single-pass vector strokes.
\newcommand{\InkStroke}[2][]{%
 \begingroup\pgfmathsetseed{1965}%
 \ifnum\pdfmatch{(->|<-|arrow|Stealth|figvec|figaxis|dagarr|shorten)}{\detokenize{#1}}=1
  \draw[ink line,#1] #2;
 \else
  \draw[ink v3 stroke,#1] #2;
 \fi
 \endgroup}
\newcommand{\InkRegion}[2][inkblue]{\path[fill=white] #2;\path[ink grain=#1] #2;}

% Tight glyph-shaped white halo, not a node-sized rectangular background.
% Default dot preserves the current node text color.
\newcommand{\InkStamp}[3]{\makebox[0pt][l]{\kern#1pt\raisebox{#2pt}[0pt][0pt]{#3}}}
